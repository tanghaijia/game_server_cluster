#!/usr/bin/env bash
set -euo pipefail

APP_NAME="controller-go"
APP_DIR="$(cd "$(dirname "$0")" && pwd)"
PID_FILE="${APP_DIR}/${APP_NAME}.pid"
LOG_FILE="${APP_DIR}/${APP_NAME}.log"

# ============================================================
# 默认配置（可通过环境变量覆盖）
# ============================================================
export DB_HOST="${DB_HOST:-localhost}"
export DB_PORT="${DB_PORT:-5432}"
export DB_USER="${DB_USER:-postgres}"
export DB_PASSWORD="${DB_PASSWORD:-postgres}"
export DB_NAME="${DB_NAME:-game_server}"
export ASSET_SERVICE_ADDR="${ASSET_SERVICE_ADDR:-localhost:9091}"
export HTTP_PORT="${HTTP_PORT:-8080}"

# ============================================================
# 颜色输出
# ============================================================
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

info()  { echo -e "${GREEN}[INFO]${NC}  $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC}  $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*"; }

# ============================================================
# 子命令
# ============================================================
usage() {
    cat <<EOF
用法: $0 {start|stop|restart|status}

环境变量:
  DB_HOST            数据库地址              (默认: localhost)
  DB_PORT            数据库端口              (默认: 5432)
  DB_USER            数据库用户              (默认: postgres)
  DB_PASSWORD        数据库密码              (默认: postgres)
  DB_NAME            数据库名                (默认: game_server)
  ASSET_SERVICE_ADDR AssetService gRPC 地址  (默认: localhost:9091)
  HTTP_PORT          HTTP 监听端口            (默认: 8080)
EOF
    exit 1
}

start() {
    if [[ -f "$PID_FILE" ]]; then
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            warn "${APP_NAME} 已在运行 (PID: $pid)"
            return 0
        fi
        warn "发现过期 PID 文件，清理中..."
        rm -f "$PID_FILE"
    fi

    info "启动 ${APP_NAME}..."
    info "  数据库:    ${DB_HOST}:${DB_PORT}/${DB_NAME}"
    info "  Asset:     ${ASSET_SERVICE_ADDR}"
    info "  HTTP 端口: ${HTTP_PORT}"
    echo ""

    cd "$APP_DIR"

    # 构建（生产环境可注释掉，使用预编译二进制）
    if [[ ! -x "${APP_DIR}/${APP_NAME}" ]]; then
        info "编译二进制..."
        go build -o "${APP_NAME}" .
    fi

    # 启动
    nohup "./${APP_NAME}" >> "$LOG_FILE" 2>&1 &
    pid=$!
    echo "$pid" > "$PID_FILE"

    # 等待几秒检查是否存活
    sleep 1
    if kill -0 "$pid" 2>/dev/null; then
        info "${APP_NAME} 启动成功 (PID: $pid)"
    else
        error "${APP_NAME} 启动失败，请查看日志: ${LOG_FILE}"
        rm -f "$PID_FILE"
        exit 1
    fi
}

stop() {
    if [[ ! -f "$PID_FILE" ]]; then
        warn "PID 文件不存在，${APP_NAME} 未在运行"
        return 0
    fi

    pid=$(cat "$PID_FILE")
    info "停止 ${APP_NAME} (PID: $pid)..."

    kill "$pid" 2>/dev/null || true

    # 等待进程退出
    for i in $(seq 1 10); do
        if ! kill -0 "$pid" 2>/dev/null; then
            break
        fi
        sleep 0.5
    done

    if kill -0 "$pid" 2>/dev/null; then
        warn "进程未响应，强制停止..."
        kill -9 "$pid" 2>/dev/null || true
    fi

    rm -f "$PID_FILE"
    info "${APP_NAME} 已停止"
}

status() {
    if [[ -f "$PID_FILE" ]]; then
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            info "${APP_NAME} 正在运行 (PID: $pid)"
            return 0
        fi
        warn "PID 文件存在但进程已消失"
        rm -f "$PID_FILE"
    else
        warn "${APP_NAME} 未在运行"
    fi
}

restart() {
    stop
    start
}

# ============================================================
# 入口
# ============================================================
case "${1:-}" in
    start)   start   ;;
    stop)    stop    ;;
    restart) restart ;;
    status)  status  ;;
    *)       usage   ;;
esac
